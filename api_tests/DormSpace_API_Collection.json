{
  "info": {
    "name": "DormSpace Sprint 2 - Admin API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Admin Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"admin@dormspace.ac.th\", \"password\": \"admin123\"}"
        },
        "url": {
          "raw": "http://localhost:3000/api/auth/login",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "2. Get All Buildings",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          }
        ],
        "url": {
          "raw": "http://localhost:3000/api/admin/buildings",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "api",
            "admin",
            "buildings"
          ]
        }
      }
    },
    {
      "name": "3. Create Building",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Building D - Tulip\", \"total_floors\": 4, \"gender_type\": \"mixed\", \"description\": \"New building\"}"
        },
        "url": {
          "raw": "http://localhost:3000/api/admin/buildings",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "api",
            "admin",
            "buildings"
          ]
        }
      }
    },
    {
      "name": "4. Create Room with Amenities",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"building_id\": 1, \"type_id\": 1, \"room_number\": \"105\", \"floor\": 1, \"price\": 4500, \"status\": \"available\", \"amenities\": [1, 2], \"image_urls\": [\"https://images.unsplash.com/photo-1555854877-bab0e564b8d5\"]}"
        },
        "url": {
          "raw": "http://localhost:3000/api/admin/rooms",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "api",
            "admin",
